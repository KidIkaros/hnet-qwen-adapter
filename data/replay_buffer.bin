require 'rubygems'
require 'nokogiri'
require 'open-uri'
url = 'https://en.wikipedia.org/wiki/Nile'
doc = Nokogiri::HTML(open(url))
table = doc.css('table.infobox.geography.vcard')[0]
rows = table.css('tr')
rows.each do |row|
 cells = row.css('td')
 if cells[0].text == 'Countries'
 countries = cells[1].text.split(', ')
 puts "The Nile River traverses through #{countries.join(', ')}"
 end
end
```
