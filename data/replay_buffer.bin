class ShoppingList:
 def __init__(self, name):
 self.name = name
 self.items = []
class ShoppingListApp:
 def __init__(self):
 self.shopping_lists = []
 def create_shopping_list(self, name):
 shopping_list = ShoppingList(name)
 self.shopping_lists.append(shopping_list)
 def switch_shopping_list(self, name):
 for shopping_list in self.shopping_lists:
 if shopping_list.name == name:
 return shopping_list
 return None
 def add_item_to_shopping_list(self, shopping_list_name, item):
 shopping_list = self.switch_shopping_list(shopping_list_name)
 if shopping_list:
 shopping_list.items.append(item)
 else:
 print("Shopping list not found.")
 def delete_shopping_list(self, name):
 for shopping_list in self.shopping_lists:
 if shopping_list.name == name:
 self.shopping_lists.remove(shopping_list)
 break
 def delete_item_from_shopping_list(self, shopping_list_name, item):
 shopping_list = self.switch_shopping_list(shopping_list_name)
 if shopping_list:
 try:
 shopping_list.items.remove(item)
 except ValueError:
 print("Item not found in shopping list.")
 else:
 print("Shopping list not found.")
