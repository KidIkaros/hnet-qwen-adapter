      (if (<f hours 10) "0" "")
      hours
      (if (<f minutes 10) "0" "")
      minutes)))

(def-date-format DD-MM-YYYY-hh-mm nil
    (((d-first-slashed-date time-24-no-seconds) (1 2) transform-date-phrase-and-time-of-day-into-g2-time-stamp))
  (progn
    (tformat "~A~S/~A~S/~S" 
