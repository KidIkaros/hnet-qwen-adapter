                protected void leave(ActivityExecution execution) {
    

    

                    ExecutionSequence execSequence = SimulatorContext.getSimulatorExecutionContext().getActiveExecutionSequence();
    

                    ExecutionElement element;
    

    

                    if (execSequence != null) {
    

    

                        PvmTransition outgoingSeqFlow = null;
    

                        Iterator<PvmTransition> transitionIterator = execution.getActivity().getOutgoingTransitions().iterator();
    

    

    

                        while (outgoingSeqFlow == null && transitionIterator.hasNext()) {
    

                            PvmTransition seqFlow = transitionIterator.next();
    

    

                            element = execSequence.getElement(seqFlow.getId());
    

    

                            if (element != null) {
    

                                outgoingSeqFlow = seqFlow;
    

                            }
    

                        }
    

    

                        if (outgoingSeqFlow != null) {
    

                            //Aca es donde se determina porque transición continuar para realizar la ejecución del path en el contexto
    

                            execution.take(outgoingSeqFlow);
    

                        } else {
    

