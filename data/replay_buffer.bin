tool_name: TND Exchange Rate API
definition: GET the average exchange rate of Tunisian Dinar (TND) against US Dollar
  (USD) and Euro (EUR)
arguments:
- parameter_name: string
  description: The string for which the exchange rate is required
  type: string
required:
- string
results:
- parameter_name: tnd_to_usd
  description: The average exchange rate of TND against USD
  type: float
- parameter_name: tnd_to_eur
  description: The average exchange rate of TND against EUR
  type: float

tool_name: Get Latest Futures Contracts
definition: This API returns the latest futures contracts for a given symbol for the
  next twelve months. You can optionally specify a specific month to retrieve the
  latest contract for that month.
arguments:
- parameter_name: symbol
  description: The symbol of the futures contract
  type: string
- parameter_name: month
  description: The month for which to retrieve the latest contract (optional)
  type: float
required:
- symbol
results:
- parameter_name: contracts
  description: A list of latest futures contracts for the given symbol
  type: array
  items:
    type: dict
    properties:
      contract_id:
        description: The unique ID of the contract
        type: string
      symbol:
        description: The symbol of the contract
        type: string
      expiration_string:
        description: The string of contract expiration
        type: string
      strike_price:
        description: The strike price of the contract
        type: float

tool_name: Yahoo Finance News
definition: Returns the latest news articles related to a specified stock symbol.
arguments:
- parameter_name: symbol
  description: The stock symbol of the company for which you want to retrieve news
    articles.
  type: string
required:
- symbol
results:
- parameter_name: news_articles
  description: An array of news articles related to the specified stock symbol.
  type: array
  items:
    type: dict
    properties:
      title:
        description: The title of the news article.
        type: string
      description:
        description: A brief summary of the news article.
        type: string
      url:
        description: The URL of the news article.
        type: string
      string:
        description: The string the news article was published.
        type: string

