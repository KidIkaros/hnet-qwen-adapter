(def-date-format MM-DD-YYYY-hh-mm nil
    (((m-first-slashed-date time-24-no-seconds) (1 2) transform-date-phrase-and-time-of-day-into-g2-time-stamp))
  (progn
    (tformat "~A~S/~A~S/~S" 
	     (if (<f month 10) "0" "")
	     month
	     (if (<f day 10) "0" "")
	     day
	     year)
