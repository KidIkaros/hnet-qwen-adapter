	(/ (producto-escalar-map x y) (sqrt (* (modulo-map x) (modulo-map y))))))

(defun producto-escalar-map (x y)
	(apply #'+ (mapcar #'(lambda (u v) (* u v)) x y)))

 (defun modulo-map (lst)
   (producto-escalar-map lst lst))

(defun vector-nulo (lst)
	(every #'identity (mapcar #'(lambda (x) (= x 0)) lst)))

