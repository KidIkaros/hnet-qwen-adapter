Second point, maybe put a link to the documentation about how to create tags (https://docs.oracle.com/en-us/iaas/Content/Tagging/Tasks/Create_tag_key_definition.htm#Create_tag_key_definition), I wasn't even aware of these tags before I tried to install and wasn't sure what was needed. Other option (which would be even better) is to code something like the following to create the tag/namespace:
resource "oci_identity_tag_namespace" "oke_tag_namespace" {
  #Required
  compartment_id = var.compartment_id
  description = var.oke_tag_namespace_description
  name = var.oke_tag_namespace_name
  count = var.deploy_tags ? 1:0
}

resource "oci_identity_tag" "pool_tag" {
  #Required
  description = var.pool_tag_description
  name = var.pool_tag_name
  tag_namespace_id = oci_identity_tag_namespace.oke_tag_namespace[0].id
  validator {
    #Required
    validator_type = var.pool_tag_validator_type
    values = var.pool_tag_validator_values
  }
  count = var.deploy_tags ? 1:0
}

variable "deploy_tags" {
  default = false
  description = "Deploy the OKE tag, only necessary for the first cluster (will fail if installing a second time)"
  type = bool
}

variable "oke_tag_namespace_name" {
  default = "oke"
  description = "Kubernetes Cluster Autoscaler tag namespace"
  type = string
